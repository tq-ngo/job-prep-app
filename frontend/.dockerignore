# frontend/.dockerignore
#
# Files excluded from the Docker build context.

# Dependencies — installed cleanly via npm ci
node_modules

# Next.js build output — built fresh inside the container
.next
out

# Version control
.git
.gitignore

# Environment files — secrets never enter the build context
.env
.env.*
!.env.example

# Editor config
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Tests & local tooling artifacts
coverage
.nyc_output
e2e
playwright.config.ts
playwright-report
test-results
vitest.config.mts
src/__tests__

# Build metadata & docs
Dockerfile
.dockerignore
README.md
