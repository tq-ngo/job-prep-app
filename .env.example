# PostgreSQL
POSTGRES_USER=jobprep
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=jobprep
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://jobprep:CHANGE_ME_postgres_password@postgres:5432/jobprep

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
FLOWER_BASIC_AUTH=admin:jobprep2026

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=text-embedding-004

# LinkedIn session cookie from browser
LINKEDIN_LI_AT=

# App
APP_ENV=development
SECRET_KEY=CHANGE_ME_generate_a_random_secret_key
CORS_ORIGINS=http://localhost:3000
# --- Google OAuth 2.0 ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# --- Cookies ---
# MUST be true in production (HTTPS). Only false for plain-HTTP localhost dev.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
