# PostgreSQL
POSTGRES_USER=jobprep
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=jobprep
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://jobprep:CHANGE_ME_postgres_password@postgres:5432/jobprep

# Redis
REDIS_URL=redis://redis:6379/0

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_minio_password
MINIO_BUCKET_JOBS=job-snapshots

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=text-embedding-004

# LinkedIn session cookie from browser
LINKEDIN_LI_AT=

# App
APP_ENV=development
SECRET_KEY=CHANGE_ME_generate_a_random_secret_key
CORS_ORIGINS=http://localhost:3000