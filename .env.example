# PostgreSQL
POSTGRES_USER=jobprep
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=jobprep
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://jobprep:CHANGE_ME_postgres_password@postgres:5432/jobprep

# Redis (password required; the server refuses to start without it)
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0

# Celery
CELERY_BROKER_URL=redis://:CHANGE_ME_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_redis_password@redis:6379/2
# Flower (dev only, docker-compose.override.yml). No default: the old
# admin:jobprep2026 was a published credential.
FLOWER_BASIC_AUTH=admin:CHANGE_ME_flower_password

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=text-embedding-004

# LinkedIn session cookie from browser
LINKEDIN_LI_AT=

# App
APP_ENV=development
SECRET_KEY=CHANGE_ME_generate_a_random_secret_key
CORS_ORIGINS=http://localhost
# --- Google OAuth 2.0 ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same-origin: Google redirects to the PUBLIC origin (nginx), never to :8000,
# so the cookies the callback sets belong to the origin the app runs on.
GOOGLE_REDIRECT_URI=http://localhost/api/v1/auth/google/callback
FRONTEND_URL=http://localhost

# --- Cookies ---
# MUST be true in production (HTTPS). Only false for plain-HTTP localhost dev.
# The API refuses to start if FRONTEND_URL is https:// or APP_ENV=production
# while this is false.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
