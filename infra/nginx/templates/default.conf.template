# Rendered by the nginx image's entrypoint into /etc/nginx/conf.d/default.conf.
# Only ${SERVER_NAME} is substituted (NGINX_ENVSUBST_FILTER in compose);
# nginx's own variables pass through untouched.

# Catch-all: requests for any Host not in SERVER_NAME get no response. The
# app server used to answer every Host header, so a rebinding domain or a
# forged Host reached the app, and Next.js builds redirect URLs from Host.
server {
    listen 80 default_server;
    server_name _;

    # Container healthcheck; answers on any Host so it works whatever
    # SERVER_NAME is set to.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 444;
    }
}

server {
    listen 80;
    server_name ${SERVER_NAME};

    # ── Security headers (all responses, including errors) ──────────────
    # script-src keeps 'unsafe-inline' on purpose. Next.js writes its RSC
    # payload as inline <script> tags whose contents change per page, so
    # hashes can't cover them; a per-request nonce could, but a nonce makes
    # every page dynamically rendered, which would end ISR for the
    # marketing page. The other directives still block foreign scripts,
    # framing, plugins and form posts elsewhere.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.googleusercontent.com; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;
    # HSTS and upgrade-insecure-requests belong on the HTTPS server; see
    # ../tls.conf.example. (Browsers ignore HSTS sent over plain HTTP.)

    # Shared proxy headers. X-Forwarded-For is OVERWRITTEN with the real
    # peer, not appended to ($proxy_add_x_forwarded_for): this nginx is
    # the edge, so any inbound value is client-supplied and was being
    # used to dodge rate limits.
    #
    # All proxy_set_header directives live HERE and none in locations:
    # nginx only inherits them into a location that sets none of its
    # own, so a single per-location header silently drops the rest.
    # $connection_upgrade is '' for ordinary requests (enabling upstream
    # keepalive) and "upgrade" only for real WebSocket upgrades.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # SSE streaming routes → FastAPI backend (must come BEFORE /api/)
    location /api/v1/stream/ {
        # The backend also caps streams per user; this caps per address,
        # before a connection reaches the app at all.
        limit_conn perip 5;
        proxy_pass http://backend;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        chunked_transfer_encoding off;
        proxy_read_timeout 86400s;
        proxy_connect_timeout 75s;
    }

    location /api/v1/auth/ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://backend;
        proxy_read_timeout 60s;
    }

    # API routes → FastAPI backend
    location /api/ {
        limit_req zone=api burst=60 nodelay;
        proxy_pass http://backend;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }

    # nginx's own container healthcheck, for when the probe's Host
    # (127.0.0.1) is one of SERVER_NAME's names.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    # Health check → FastAPI
    location = /health {
        proxy_pass http://backend;
    }

    # API docs are never served publicly. The private-range allowlist that
    # used to guard them didn't hold under Docker Desktop, where every
    # client arrives from the bridge gateway (a 172.16/12 address). The
    # backend doesn't serve them at all when APP_ENV=production; in dev
    # they're at http://127.0.0.1:8000/docs (docker-compose.override.yml).
    location ~ ^/(docs|redoc|openapi\.json)$ {
        return 404;
    }

    # Everything else → Next.js frontend
    location / {
        proxy_pass http://frontend;
    }
}
