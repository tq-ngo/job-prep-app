# Rendered by the nginx image's entrypoint into /etc/nginx/conf.d/default.conf.
# Only ${SERVER_NAME} is substituted (NGINX_ENVSUBST_FILTER in compose);
# nginx's own variables pass through untouched.

# Catch-all: requests for any Host not in SERVER_NAME get no response.
server {
    listen 80 default_server;
    server_name _;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 444;
    }
}

server {
    listen 80;
    server_name ${SERVER_NAME};

    # Security headers (all responses, including errors).
    # script-src retains 'unsafe-inline' per AGENTS.md so Next.js RSC inline
    # payloads work without breaking 300s marketing ISR.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.googleusercontent.com https://t2.gstatic.com; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;

    include /etc/nginx/snippets/app.conf;
}
