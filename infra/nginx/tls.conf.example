# HTTPS for a real deployment — an example, not loaded by default.
#
# 1. Put certificates where the container can read them, e.g. mount
#    /etc/letsencrypt/live/<domain>/ to /etc/nginx/certs/ (read-only).
# 2. Copy this file to templates/default.conf.template (replacing the plain-HTTP
#    one), keeping the location blocks from the original in the 443 server.
# 3. Publish 443 in docker-compose.yml ("443:443"), set SERVER_NAME to the
#    domain, and set in .env:
#        FRONTEND_URL=https://<domain>
#        GOOGLE_REDIRECT_URI=https://<domain>/api/v1/auth/google/callback
#        CORS_ORIGINS=https://<domain>
#        COOKIE_SECURE=true
#        APP_ENV=production
#    The backend refuses to start with an https FRONTEND_URL and insecure
#    cookies, so these must change together.

# Plain HTTP only redirects (and keeps the container healthcheck working).
server {
    listen 80 default_server;
    server_name _;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Unknown Host on HTTPS: refuse during the handshake, without presenting
# the real certificate.
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Only meaningful over HTTPS: browsers ignore HSTS on plain HTTP. Start
    # with a short max-age while testing; add `preload` only deliberately.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # Same CSP as the HTTP template plus upgrade-insecure-requests.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.googleusercontent.com; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;

    # ── Behind a load balancer or CDN ───────────────────────────────────
    # Then $remote_addr is the balancer, so every client shares one rate
    # limit bucket. Trust the balancer's forwarded header — and ONLY from
    # the balancer's own addresses, or clients can forge it:
    #
    #   set_real_ip_from 10.0.0.0/8;          # your balancer's range
    #   real_ip_header   X-Forwarded-For;
    #   real_ip_recursive on;
    #
    # $remote_addr (and so X-Forwarded-For sent to the backend) then holds
    # the real client address.

    # proxy_set_header block and every location from the HTTP template go
    # here unchanged, with X-Forwarded-Proto now "https".
}
