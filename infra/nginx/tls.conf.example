# HTTPS for a real deployment — an example, not loaded by default.
#
# 1. Put certificates where the container can read them, e.g. mount
#    /etc/letsencrypt/live/<domain>/ to /etc/nginx/certs/ (read-only).
# 2. Copy this file to templates/default.conf.template (replacing the plain-HTTP
#    one); all proxy headers and location blocks are shared via snippets/app.conf.
# 3. Publish 443 in docker-compose.yml ("443:443"), set SERVER_NAME to the
#    domain, and set in .env:
#        FRONTEND_URL=https://<domain>
#        GOOGLE_REDIRECT_URI=https://<domain>/api/v1/auth/google/callback
#        CORS_ORIGINS=https://<domain>
#        COOKIE_SECURE=true
#        APP_ENV=production

# Unknown Host on plain HTTP: drop immediately (never 301-redirect arbitrary
# Host headers, which would create an open redirect on port 80).
server {
    listen 80 default_server;
    server_name _;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 444;
    }
}

# Allowlisted Host on plain HTTP: redirect permanently to HTTPS.
server {
    listen 80;
    server_name ${SERVER_NAME};

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Unknown Host on HTTPS: refuse during TLS handshake without presenting a cert.
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.googleusercontent.com https://t2.gstatic.com; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;

    # ── Behind a load balancer or CDN ───────────────────────────────────
    # Trust the balancer's X-Forwarded-For ONLY from the balancer's CIDR:
    #
    #   set_real_ip_from 10.0.0.0/8;
    #   real_ip_header   X-Forwarded-For;
    #   real_ip_recursive on;

    include /etc/nginx/snippets/app.conf;
}
